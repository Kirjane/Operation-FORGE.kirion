{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kirion-forge.local/integrations/antigravity/schemas/mission-packet-v2.schema.json",
  "title": "KIRION Forge Mission Contract (protocol version 2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "mission_id",
    "authorization_ref",
    "verifier",
    "repo_name",
    "base_sha",
    "permitted_branch",
    "project_origin",
    "work_mode",
    "contract_refs",
    "acceptance_criteria",
    "cognition_hash",
    "selected_skills",
    "assigned_persona",
    "formal_role",
    "owned_paths",
    "depends_on",
    "risk_class",
    "required_gates",
    "budget",
    "stop_conditions",
    "allowed_operations",
    "delivery_destination",
    "repo_id",
    "revision",
    "previous_contract_sha256",
    "revision_reason",
    "excluded_paths",
    "objective",
    "source_authorities",
    "oracles",
    "required_capabilities",
    "cognition",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "run_id": {
      "type": "string",
      "minLength": 3
    },
    "mission_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{1,63}$"
    },
    "authorization_ref": {
      "type": "string",
      "minLength": 3
    },
    "verifier": {
      "type": "string",
      "minLength": 2
    },
    "repo_id": {
      "type": "integer",
      "minimum": 1
    },
    "repo_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "permitted_branch": {
      "type": "string",
      "minLength": 2
    },
    "project_origin": {
      "type": "string",
      "enum": [
        "GREENFIELD",
        "BROWNFIELD"
      ]
    },
    "work_mode": {
      "type": "string",
      "enum": [
        "DISCOVERY",
        "IN_FLIGHT",
        "MAINTENANCE",
        "RECOVERY",
        "PAUSED"
      ]
    },
    "contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cognition_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "selected_skills": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_source_sha",
        "files"
      ],
      "properties": {
        "skill_source_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "assigned_persona": {
      "type": "string",
      "enum": [
        "Antigravity-Maintainer",
        "Antigravity-Lucien",
        "Antigravity-Jane",
        "Antigravity-Nox",
        "Antigravity-Argon",
        "Antigravity-Iris",
        "Antigravity-QA",
        "Antigravity-Aegis",
        "Antigravity-Integrator",
        "Antigravity-Scribe"
      ]
    },
    "formal_role": {
      "type": "string",
      "enum": [
        "Maintainer",
        "Code Writer",
        "Integration Writer",
        "Reviewer"
      ]
    },
    "owned_paths": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "owned_modules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "owned_behaviors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9][A-Z0-9_-]{1,63}$"
      }
    },
    "risk_class": {
      "type": "string",
      "enum": [
        "RISK-0",
        "RISK-1",
        "RISK-2",
        "RISK-3",
        "RISK-4"
      ]
    },
    "required_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^G(0[0-9]|1[0-5])$"
      }
    },
    "non_applicable_gates": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "gate_commands": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_parallel_writers",
        "max_parallel_reviewers",
        "max_repair_cycles",
        "max_identical_retries",
        "max_nesting_depth",
        "max_wall_seconds"
      ],
      "properties": {
        "max_parallel_writers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "max_parallel_reviewers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "max_repair_cycles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "max_identical_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "max_nesting_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "READ",
          "WRITE_OWNED",
          "RUN_GATE",
          "REVIEW_READONLY",
          "INTEGRATE_BRANCH",
          "DELIVER_DRAFT_PR"
        ]
      }
    },
    "delivery_destination": {
      "type": "string",
      "minLength": 2
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "previous_contract_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision_reason": {
      "type": "string",
      "minLength": 1
    },
    "excluded_paths": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "outcomes",
        "non_goals"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outcome_id",
              "actor",
              "scenario",
              "expected",
              "oracle_ids"
            ],
            "properties": {
              "outcome_id": {
                "type": "string",
                "minLength": 1
              },
              "actor": {
                "type": "string",
                "minLength": 1
              },
              "scenario": {
                "type": "string",
                "minLength": 1
              },
              "expected": {
                "type": "string",
                "minLength": 1
              },
              "oracle_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "non_goals": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source_authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "repository_id",
          "repository_name",
          "commit_sha",
          "scope",
          "authority_kind"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "repository_id": {
            "type": "integer",
            "minimum": 1
          },
          "repository_name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "scope": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "authority_kind": {
            "type": "string",
            "enum": [
              "PRESENTATION",
              "FUNCTIONAL",
              "SECURITY",
              "CONSTRAINT",
              "REFERENCE"
            ]
          }
        }
      }
    },
    "oracles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "oracle_id",
          "outcome_ids",
          "gate_id",
          "source_id",
          "path",
          "blob_sha",
          "command_argv",
          "fixture_sha256",
          "target_profile",
          "environment",
          "expected_observation",
          "evidence_type",
          "minimum_evidence_level",
          "negative_control",
          "evaluation_kind"
        ],
        "properties": {
          "oracle_id": {
            "type": "string",
            "minLength": 1
          },
          "outcome_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "gate_id": {
            "type": "string",
            "pattern": "^G(0[0-9]|1[0-5])$"
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "blob_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "command_argv": {
            "type": [
              "array",
              "null"
            ],
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "fixture_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "target_profile": {
            "type": "string",
            "enum": [
              "REAL",
              "MOCK",
              "SYNTHETIC"
            ]
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "expected_observation": {
            "type": "string",
            "minLength": 1
          },
          "evidence_type": {
            "type": "string",
            "enum": [
              "SOURCE",
              "BUILD",
              "UNIT",
              "INTEGRATION",
              "RUNTIME",
              "SECURITY"
            ]
          },
          "minimum_evidence_level": {
            "type": "string",
            "enum": [
              "E0",
              "E1",
              "E2",
              "E3",
              "E4",
              "E5",
              "E6",
              "E7"
            ]
          },
          "negative_control": {
            "type": "string",
            "minLength": 1
          },
          "evaluation_kind": {
            "type": "string",
            "enum": [
              "COMMAND",
              "REVIEWED_OBSERVATION"
            ]
          }
        }
      }
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability_id",
          "operation",
          "scope",
          "environment",
          "independence_required"
        ],
        "properties": {
          "capability_id": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "enum": [
              "READ",
              "WRITE_OWNED",
              "RUN_GATE",
              "REVIEW_READONLY",
              "INTEGRATE_BRANCH",
              "DELIVER_DRAFT_PR"
            ]
          },
          "scope": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "independence_required": {
            "type": "boolean"
          }
        }
      }
    },
    "cognition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "brain_run_id",
        "context_sha256",
        "manifest_ref",
        "target_binding",
        "reason"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "INHERITED",
            "OMITTED",
            "UNAVAILABLE"
          ]
        },
        "brain_run_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "context_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "target_binding": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer_actor_id",
        "issuer_role",
        "directive_ref",
        "directive_sha256",
        "grant_scope",
        "parent_grant_ref",
        "permitted_revision_fields",
        "source_precedence",
        "brain_required"
      ],
      "properties": {
        "issuer_actor_id": {
          "type": "integer",
          "minimum": 1
        },
        "issuer_role": {
          "type": "string",
          "enum": [
            "Engineer",
            "Maintainer"
          ]
        },
        "directive_ref": {
          "type": "string",
          "minLength": 1
        },
        "directive_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "grant_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "parent_grant_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "permitted_revision_fields": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_precedence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "brain_required": {
          "type": "boolean"
        }
      }
    }
  }
}
