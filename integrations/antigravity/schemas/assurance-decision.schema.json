{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Forge separately authorized fixture assurance decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_sha256",
    "revision",
    "reservation_id",
    "plan_sha256",
    "candidate_sha",
    "tree_sha",
    "issuer_id",
    "issuer_actor_id",
    "issuer_context_id",
    "nonce",
    "issued_at_utc",
    "expires_at_utc",
    "receipt_sha256s",
    "decision",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "reservation_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "tree_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "issuer_id": {
      "type": "string",
      "minLength": 1
    },
    "issuer_actor_id": {
      "type": "string",
      "minLength": 1
    },
    "issuer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "nonce": {
      "type": "string",
      "minLength": 1
    },
    "issued_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "expires_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "receipt_sha256s": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "decision": {
      "type": "string",
      "const": "ACCEPT_FIXTURE"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
