{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kirion.invalid/assurance/r2a-v0.2/claim-request.schema.json",
  "title": "R2-A v0.2 UNTRUSTED claim request (not an authority receipt)",
  "description": "All data supplied here is claimant-authored. No gate policy, trusted receipt, oracle, or approval can be supplied in this envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission",
    "claim",
    "offered_evidence_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "r2a-0.2-draft"
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_id",
        "repository",
        "candidate_sha"
      ],
      "properties": {
        "mission_id": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "repository": {
          "type": "string",
          "pattern": "^[^ /]+/[^ /]+$"
        },
        "candidate_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "authority_hint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "type",
        "statement",
        "target"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "type": {
          "enum": [
            "SOURCE_REVIEWED",
            "SOURCE_INTEGRITY_VERIFIED",
            "AUTOMATED_VALIDATION",
            "RUNTIME_ACCEPTANCE",
            "RELEASE_READY"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 12
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "environment",
            "data_authority"
          ],
          "properties": {
            "kind": {
              "enum": [
                "source-tree",
                "ci-validation",
                "runtime-entrypoint",
                "release-artifact"
              ]
            },
            "environment": {
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*"
            },
            "data_authority": {
              "enum": [
                "source",
                "mock-fixture",
                "disposable-live-host",
                "installed-runtime",
                "not-applicable"
              ]
            },
            "entrypoint": {
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*"
            },
            "artifact_digest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "validation_scope": {
              "type": "string",
              "minLength": 1,
              "pattern": ".*\\S.*"
            },
            "content_scope": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": ".*\\S.*"
              }
            }
          }
        },
        "requested_evidence_level": {
          "enum": [
            "E0",
            "E1",
            "E2",
            "E3",
            "E4",
            "E5",
            "E6",
            "E7"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "SOURCE_REVIEWED"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "properties": {
                  "kind": {
                    "const": "source-tree"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "requested_evidence_level": {
                "const": "E1"
              }
            },
            "required": [
              "requested_evidence_level"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "SOURCE_INTEGRITY_VERIFIED"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "properties": {
                  "kind": {
                    "const": "source-tree"
                  }
                },
                "required": [
                  "kind",
                  "content_scope"
                ]
              },
              "requested_evidence_level": {
                "const": "E4"
              }
            },
            "required": [
              "requested_evidence_level"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "AUTOMATED_VALIDATION"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "properties": {
                  "kind": {
                    "const": "ci-validation"
                  }
                },
                "required": [
                  "kind",
                  "validation_scope"
                ]
              },
              "requested_evidence_level": {
                "const": "E4"
              }
            },
            "required": [
              "requested_evidence_level"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "RUNTIME_ACCEPTANCE"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "properties": {
                  "kind": {
                    "const": "runtime-entrypoint"
                  }
                },
                "required": [
                  "kind",
                  "entrypoint",
                  "artifact_digest_sha256"
                ]
              },
              "requested_evidence_level": {
                "const": "E5"
              }
            },
            "required": [
              "requested_evidence_level"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "RELEASE_READY"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "properties": {
                  "kind": {
                    "const": "release-artifact"
                  }
                },
                "required": [
                  "kind",
                  "artifact_digest_sha256"
                ]
              }
            },
            "not": {
              "required": [
                "requested_evidence_level"
              ]
            }
          }
        }
      ]
    },
    "offered_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": ".*\\S.*"
      }
    }
  }
}
