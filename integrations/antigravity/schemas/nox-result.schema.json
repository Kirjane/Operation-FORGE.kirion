{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kirion-forge.local/integrations/antigravity/schemas/nox-result.schema.json",
  "title": "KIRION Forge Antigravity-Nox Fresh-Context Review Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_id",
    "frozen_sha",
    "reviewer_context_id",
    "reviewer_persona",
    "author_context_id",
    "inspected_scope",
    "evidence_inspected",
    "findings",
    "verdict"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "mission_id": { "type": "string", "minLength": 2 },
    "frozen_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "reviewer_context_id": { "type": "string", "minLength": 3 },
    "reviewer_persona": {
      "type": "string",
      "enum": ["Antigravity-Nox", "Antigravity-Aegis"]
    },
    "author_context_id": { "type": "string", "minLength": 2 },
    "inspected_scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_inspected": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "path",
          "line",
          "contract_violated",
          "reproduction",
          "requested_correction",
          "disposition"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3", "P4"] },
          "path": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "contract_violated": { "type": "string", "minLength": 1 },
          "reproduction": { "type": "string", "minLength": 1 },
          "requested_correction": { "type": "string", "minLength": 1 },
          "disposition": {
            "type": "string",
            "enum": ["OPEN", "FIXED", "AUTHORIZED_DISPOSITION", "DOCUMENTED"]
          }
        }
      }
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "REWORK", "QUARANTINED"]
    }
  }
}
