{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Existing Arsenal pinned registry extension",
  "type": "object",
  "required": [
    "registry_version",
    "status",
    "candidate_count",
    "registry",
    "stage_optional",
    "task_optional",
    "noAutomaticMerge",
    "noAutomaticProjectPolicyAdoption"
  ],
  "properties": {
    "registry_version": {
      "const": 1
    },
    "status": {
      "const": "draft-not-adopted"
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "registry": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "source",
          "dependencies",
          "hosts",
          "status",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
          },
          "kind": {
            "enum": [
              "skill",
              "reference"
            ]
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository_id",
              "repository_name",
              "commit_sha",
              "path",
              "blob_sha",
              "bytes",
              "sha256"
            ],
            "properties": {
              "repository_id": {
                "type": "integer",
                "minimum": 1
              },
              "repository_name": {
                "type": "string",
                "minLength": 1
              },
              "commit_sha": {
                "type": "string",
                "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "blob_sha": {
                "type": "string",
                "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 262144
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "hosts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chatgpt",
              "codex",
              "antigravity",
              "fixture"
            ],
            "properties": {
              "chatgpt": {
                "type": "string",
                "enum": [
                  "MANUAL",
                  "ADVISORY_ONLY",
                  "UNAVAILABLE",
                  "FIXTURE"
                ]
              },
              "codex": {
                "type": "string",
                "enum": [
                  "MANUAL",
                  "ADVISORY_ONLY",
                  "UNAVAILABLE",
                  "FIXTURE"
                ]
              },
              "antigravity": {
                "type": "string",
                "enum": [
                  "MANUAL",
                  "ADVISORY_ONLY",
                  "UNAVAILABLE",
                  "FIXTURE"
                ]
              },
              "fixture": {
                "type": "string",
                "enum": [
                  "MANUAL",
                  "ADVISORY_ONLY",
                  "UNAVAILABLE",
                  "FIXTURE"
                ]
              }
            }
          },
          "status": {
            "const": "CANDIDATE"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "stage_optional": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "PRE_DESIGN",
        "PRE_IMPLEMENTATION",
        "PRE_DELIVERY",
        "POST_DEPLOY"
      ],
      "properties": {
        "PRE_DESIGN": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "PRE_IMPLEMENTATION": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "PRE_DELIVERY": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "POST_DEPLOY": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "task_optional": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "noAutomaticMerge": {
      "const": true
    },
    "noAutomaticProjectPolicyAdoption": {
      "const": true
    }
  }
}
