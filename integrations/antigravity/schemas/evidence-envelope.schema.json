{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kirion-forge.local/integrations/antigravity/schemas/evidence-envelope.schema.json",
  "title": "KIRION Forge Trusted Runner Evidence Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "mission_id",
    "stage",
    "gate_id",
    "candidate_sha",
    "tree_sha",
    "dirty",
    "command_argv",
    "cwd",
    "started_at_utc",
    "completed_at_utc",
    "exit_code",
    "status",
    "environment_versions",
    "fixture_sha256",
    "artifact_path",
    "artifact_size_bytes",
    "artifact_sha256",
    "evidence_level",
    "evidence_type",
    "provenance",
    "certainty_ceiling",
    "redacted"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "run_id": { "type": "string", "minLength": 3 },
    "mission_id": { "type": "string", "minLength": 2 },
    "stage": { "type": "string", "minLength": 2 },
    "gate_id": { "type": "string", "pattern": "^G(0[0-9]|1[0-5])$" },
    "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "tree_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "dirty": { "type": "boolean" },
    "command_argv": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "cwd": { "type": "string", "minLength": 1 },
    "started_at_utc": { "type": "string", "minLength": 10 },
    "completed_at_utc": { "type": "string", "minLength": 10 },
    "exit_code": { "type": ["integer", "null"] },
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"]
    },
    "environment_versions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "fixture_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact_path": { "type": "string", "minLength": 1 },
    "artifact_size_bytes": { "type": "integer", "minimum": 0 },
    "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidence_level": {
      "type": "string",
      "enum": ["E0", "E1", "E2", "E3", "E4", "E5", "E6", "E7"]
    },
    "evidence_type": {
      "type": "string",
      "enum": ["NONE", "SOURCE", "UNIT", "INTEGRATION", "BUILD", "RUNTIME", "SECURITY"]
    },
    "provenance": {
      "type": "string",
      "enum": ["ASSUMED", "DIRECTLY_OBSERVED", "REPORTED", "AUTOMATED", "REPRODUCED"]
    },
    "certainty_ceiling": {
      "type": "string",
      "enum": [
        "HYPOTHESIS",
        "SUPPORTED",
        "VERIFIED",
        "OBSERVED_IN_OPERATION",
        "PRODUCTION_PROVEN"
      ]
    },
    "redacted": { "type": "boolean", "const": true }
  }
}
