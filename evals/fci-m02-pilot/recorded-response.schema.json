{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operation-forge://evals/fci-m02-pilot/recorded-response.schema.json",
  "title": "FCI-M02 independently recorded agent trial (not an agent self-report)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "suite_id",
    "mode",
    "run_metadata",
    "responses"
  ],
  "properties": {
    "suite_id": {
      "const": "FCI-M02-PILOT-R0"
    },
    "mode": {
      "enum": [
        "BASELINE",
        "CANDIDATE",
        "CALIBRATION_SYNTHETIC_NOT_AGENT"
      ]
    },
    "run_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "model_provider",
        "model",
        "effort",
        "bootstrap_version_or_sha",
        "evaluator",
        "evaluated_at",
        "response_artifact",
        "response_sha256"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "model_provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "effort": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "bootstrap_version_or_sha": {
          "type": "string",
          "minLength": 1
        },
        "evaluator": {
          "type": "string",
          "minLength": 1
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "response_artifact": {
          "type": "string",
          "minLength": 1
        },
        "response_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "responses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "decision",
          "evidence",
          "actions_attempted",
          "cited_sources",
          "citations",
          "reconstruction",
          "authority_granted",
          "claimed_test_execution",
          "transcript_artifact",
          "transcript_sha256"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "actions_attempted": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cited_sources": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "source_line",
                "transcript_line"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "source_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "transcript_line": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "reconstruction": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "authority_granted": {
            "type": "boolean"
          },
          "claimed_test_execution": {
            "type": "boolean"
          },
          "transcript_artifact": {
            "type": "string",
            "minLength": 1
          },
          "transcript_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "execution_evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "run_id",
              "log_sha256"
            ],
            "properties": {
              "run_id": {
                "type": "string",
                "minLength": 1
              },
              "log_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "token_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
