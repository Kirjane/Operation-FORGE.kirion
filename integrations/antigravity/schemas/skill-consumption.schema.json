{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nonpromotable fixture skill consumption receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "plan_sha256",
    "binding",
    "status",
    "fixture_only",
    "native_loading_verified",
    "promotion_authorized",
    "loaded",
    "retrieved_not_loaded",
    "consumed_bytes",
    "result_sha256",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_sha256",
        "mission_id",
        "revision",
        "run_id",
        "repo_id",
        "repo_name",
        "base_sha",
        "branch",
        "persona",
        "formal_role",
        "actor_id",
        "host_id",
        "context_id",
        "attempt_ordinal",
        "grant_sha256",
        "cognition_sha256",
        "brain_checkpoint_sha256"
      ],
      "properties": {
        "contract_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mission_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "repo_id": {
          "type": "integer",
          "minimum": 1
        },
        "repo_name": {
          "type": "string",
          "minLength": 1
        },
        "base_sha": {
          "type": "string",
          "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "persona": {
          "type": "string",
          "minLength": 1
        },
        "formal_role": {
          "type": "string",
          "minLength": 1
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "host_id": {
          "type": "string",
          "minLength": 1
        },
        "context_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "grant_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cognition_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "brain_checkpoint_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "status": {
      "const": "FIXTURE_CONSUMED"
    },
    "fixture_only": {
      "const": true
    },
    "native_loading_verified": {
      "const": false
    },
    "promotion_authorized": {
      "const": false
    },
    "loaded": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository_id",
              "repository_name",
              "commit_sha",
              "path",
              "blob_sha",
              "bytes",
              "sha256"
            ],
            "properties": {
              "repository_id": {
                "type": "integer",
                "minimum": 1
              },
              "repository_name": {
                "type": "string",
                "minLength": 1
              },
              "commit_sha": {
                "type": "string",
                "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "blob_sha": {
                "type": "string",
                "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 262144
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "status": {
            "const": "CONSUMED_FIXTURE"
          }
        }
      }
    },
    "retrieved_not_loaded": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "consumed_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "result_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
