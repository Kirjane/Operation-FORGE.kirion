{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Forge versioned exact-bound assurance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_sha256",
    "revision",
    "repo_id",
    "repo_name",
    "base_sha",
    "branch",
    "objective_sha256",
    "grant_sha256",
    "reservation_id",
    "attempt_ordinal",
    "worker_actor_id",
    "issuer_id",
    "issuer_actor_id",
    "issuer_role",
    "issuer_context_id",
    "nonce",
    "issued_at_utc",
    "expires_at_utc",
    "plan_sha256",
    "oracle_id",
    "oracle_sha256",
    "source_sha256",
    "outcome_ids",
    "target",
    "runtime_sha256",
    "envelope",
    "execution_sha256",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "repo_id": {
      "type": "integer",
      "minimum": 1
    },
    "repo_name": {
      "type": "string",
      "minLength": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "objective_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "grant_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reservation_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_ordinal": {
      "type": "integer",
      "minimum": 1
    },
    "worker_actor_id": {
      "type": "string",
      "minLength": 1
    },
    "issuer_id": {
      "type": "string",
      "minLength": 1
    },
    "issuer_actor_id": {
      "type": "string",
      "minLength": 1
    },
    "issuer_role": {
      "type": "string",
      "enum": [
        "WRITER",
        "REVIEWER"
      ]
    },
    "issuer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "nonce": {
      "type": "string",
      "minLength": 1
    },
    "issued_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "expires_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "oracle_id": {
      "type": "string",
      "minLength": 1
    },
    "oracle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "outcome_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_id",
        "repo_name",
        "branch",
        "kind",
        "profile",
        "environment",
        "data_authority",
        "cwd",
        "device_id",
        "executable_sha256",
        "signing_policy_sha256"
      ],
      "properties": {
        "repo_id": {
          "type": "integer",
          "minimum": 1
        },
        "repo_name": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "enum": [
            "MOCK",
            "SYNTHETIC"
          ]
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "data_authority": {
          "type": "string",
          "minLength": 1
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "device_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "executable_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "signing_policy_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "runtime_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "envelope": {
      "type": "object"
    },
    "execution_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
