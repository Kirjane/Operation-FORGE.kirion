{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-second-brain://harness/claim-provenance.schema.json",
  "title": "FCI-M02 Evidence-Bound Claim V1",
  "description": "Reported claim classifications do not establish authority or executed test evidence; a trusted verifier must attest those separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "subject",
    "value",
    "classification",
    "source_id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,79}$"
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "value": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "classification": {
      "enum": [
        "OPERATOR_APPROVED",
        "CODE_VERIFIED",
        "TEST_VERIFIED",
        "RUNTIME_OBSERVED",
        "INFERRED",
        "UNKNOWN"
      ]
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,79}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contract_revision": {
      "type": "integer",
      "minimum": 1
    },
    "approval_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "superseded_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    }
  }
}
