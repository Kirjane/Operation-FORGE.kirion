{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-second-brain://harness/feature-context.schema.json",
  "title": "FCI-M02 Source-Backed Feature Context V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "feature_id",
    "repository",
    "contract",
    "sources",
    "claims"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "feature_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "head"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "head": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "revision"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,79}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,79}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "enum": [
              "CONTRACT",
              "CODE",
              "TEST",
              "RUNTIME",
              "DOCUMENT"
            ]
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "claim-provenance.schema.json"
      }
    },
    "required_claim_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]{0,79}$"
      }
    }
  }
}
